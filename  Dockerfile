# syntax=docker/dockerfile:1.6

FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# системные зависимости (psycopg, pillow и т.п.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ---- deps (prod) ----
FROM base AS deps
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# ---- deps-dev (для CI/lint stage) ----
FROM deps AS deps-dev
COPY backend/requirements-dev.txt /app/backend/requirements-dev.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-dev.txt

# ---- lint stage (линтеры "внутри") ----
FROM deps-dev AS lint
COPY backend /app/backend
WORKDIR /app/backend
# ВАЖНО: миграции пропускаем
RUN python -m black apps config --check
RUN python -m isort apps config --check-only
RUN python -m flake8 apps config
RUN python -m mypy apps config

# ---- runtime ----
FROM deps AS runtime
WORKDIR /app/backend
COPY backend /app/backend

# entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# gunicorn
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60"]